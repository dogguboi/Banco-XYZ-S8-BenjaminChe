<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.bancoxyz</groupId>
    <artifactId>banco-xyz-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Banco XYZ - Modernizacion Backend</name>
    <description>
        Proyecto de continuidad Banco XYZ (PBY2203):
        - batch-modernizacion (Exp2-S3): migracion de procesos batch legacy con Spring Batch.
        - bff-web / bff-mobile / bff-atm (Exp2-S5): patron Backend for Frontend sobre los
          datos ya saneados y persistidos por los Jobs batch.
        - auth-server + Resilience4j + Kafka + Docker (Exp3-S8): OAuth 2.0 centralizado,
          tolerancia a fallos, arquitectura orientada a eventos y contenerizacion.
    </description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lombok.version>1.18.46</lombok.version>
        <oracle.wallet.version>21.23.0.0</oracle.wallet.version>
        <spring-cloud.version>2023.0.3</spring-cloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>common-domain</module>
        <module>auth-server</module>
        <module>batch-modernizacion</module>
        <module>bff-web</module>
        <module>bff-mobile</module>
        <module>bff-atm</module>
        <module>notificaciones-service</module>
    </modules>
</project>
