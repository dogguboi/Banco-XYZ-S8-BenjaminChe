# =====================================================================
# Variables de entorno para docker-compose (Banco XYZ - Exp3-S8)
# Copia este archivo como  .env  y completa tus valores reales.
# El archivo .env NO se versiona (esta en .gitignore).
# =====================================================================

# Perfil de base de datos: oracle | demo | mysql | postgres
DB_PROFILE=oracle

# --- Oracle Autonomous Database (misma base que puebla el modulo batch) ---
# Ruta LOCAL de la carpeta del Wallet descomprimido; se monta en /wallet
WALLET_PATH=D:/Wallet_bancoXYZ
TNS_ALIAS=bancoxyz_high
DB_USER=
DB_PASSWORD=
